{
  "name": "@sdppp/pptask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./core/src/index.ts",
  "module": "./core/src/index.ts",
  "types": "./core/src/index.ts",
  "exports": {
    ".": {
      "types": "./core/src/index.ts",
      "import": "./core/src/index.ts"
    },
    "./executors/inline": {
      "types": "./executors/inline/src/index.ts",
      "import": "./executors/inline/src/index.ts"
    },
    "./locator-catalog": {
      "types": "./core/src/locator-catalog.ts",
      "import": "./core/src/locator-catalog.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "pptask:sync-provider-data": "node core/scripts/sync-provider-data.mjs",
    "pptask:generate-kie-apiframe-catalogs": "node core/scripts/generate-kie-apiframe-catalogs.mjs",
    "pptask:generate-provider-catalogs": "node core/scripts/generate-provider-catalogs.mjs",
    "pptask:sync-kie-apiframe-describe-data": "node core/scripts/sync-kie-apiframe-describe-data.mjs",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "nx": {
    "tags": [
      "scope:capability",
      "platform:agnostic",
      "type:lib"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "dotenv": "^16.4.5",
    "replicate": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "tsx": "^4.7.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
