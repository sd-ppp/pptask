{
  "name": "pptask",
  "version": "0.1.0",
  "description": "A unified TypeScript interface for AI media generation across providers.",
  "license": "Apache-2.0",
  "author": "SDPPP Contributors",
  "homepage": "https://github.com/sd-ppp/pptask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sd-ppp/pptask.git"
  },
  "bugs": {
    "url": "https://github.com/sd-ppp/pptask/issues"
  },
  "keywords": [
    "ai",
    "media-generation",
    "image-generation",
    "video-generation",
    "provider",
    "task-runner",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./executors/inline": {
      "types": "./dist/executors/inline/src/index.d.ts",
      "import": "./dist/executors/inline.js"
    },
    "./locator-catalog": {
      "types": "./dist/core/src/locator-catalog.d.ts",
      "import": "./dist/locator-catalog.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:build": "pnpm run build && node scripts/test-build.mjs",
    "pptask:sync-provider-data": "node core/scripts/sync-provider-data.mjs",
    "pptask:generate-kie-apiframe-catalogs": "node core/scripts/generate-kie-apiframe-catalogs.mjs",
    "pptask:generate-provider-catalogs": "node core/scripts/generate-provider-catalogs.mjs",
    "pptask:sync-kie-apiframe-describe-data": "node core/scripts/sync-kie-apiframe-describe-data.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "scope:capability",
      "platform:agnostic",
      "type:lib"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "dotenv": "^16.4.5",
    "replicate": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "tsx": "^4.7.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
