{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["tests", "dist", "node_modules"]
}
