# This is an example configuration file for testing.
# Copy this file to test.env and fill in your actual values for running integration tests.

# Replicate integration (required to enable Replicate tests)
REPLICATE_API_KEY=

# RunningHub integration (required to enable RunningHub tests)
RUNNINGHUB_API_KEY=

# Grsai integration (required to enable Grsai tests)
# Note: baseUrl and model should be specified in code when creating executor, not via environment variables
# Only GRSAI_API_KEY is needed for integration tests
GRSAI_API_KEY=

# PPIO image integration (required to enable PPIO tests)
PPIO_API_KEY=
# PPIO_BASE_URL=https://api.ppio.com/v3/gemini-image
# PPIO_GPT_IMAGE_BASE_URL=https://api.ppio.com/v3
# PPIO_RESPONSE_BASE_URL=https://api.ppio.com/openai/v1
# PPIO_CHAT_BASE_URL=https://api.ppio.com/openai/v1
# PPIO_ASYNC_BASE_URL=https://api.ppio.com/v3/async
# PPIO_VEO_BASE_URL=https://api.ppio.com/v3/veo-3.1
# PPIO_MINIMAX_BASE_URL=https://api.ppio.com/v3/minimax/v2
# PPIO_SEEDANCE_CN_METERED_BASE_URL=https://api.ppio.com/v3/bytedance-cn/metered
# PPIO_VEO_API_VERSION=v1
# PPIO_API_VERSION=v1beta1
# PPIO_MODEL=gemini-2.5-flash-image
