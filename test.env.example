# Integration Test Configuration
# Copy to test.env and add your API keys

# Replicate integration (required to enable Replicate tests)
REPLICATE_API_KEY=

# RunningHub integration (required to enable RunningHub tests)
RUNNINGHUB_API_KEY=
RUNNINGHUB_MAX_CONCURRENCY=3
# RUNNINGHUB_CASE_REPEAT=1

# Grsai integration (required to enable Grsai tests)
GRSAI_API_KEY=

PORT=19925
