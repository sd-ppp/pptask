{
  "locator": "apiframe://image/flux-2-pro",
  "modelId": "flux-2-pro",
  "providerId": "apiframe",
  "modality": "image",
  "label": "Flux 2 Pro",
  "outputType": "image",
  "endpoint": {
    "method": "POST",
    "path": "/v2/images/generate"
  },
  "requestSchema": {
    "type": "object",
    "required": [
      "model",
      "prompt"
    ],
    "properties": {
      "model": {
        "enum": [
          "flux-2-pro"
        ],
        "type": "string"
      },
      "fluxParams": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "pattern": "^\\d+:\\d+$",
            "type": "string"
          },
          "go_fast": {
            "type": "boolean"
          },
          "guidance": {
            "maximum": 10,
            "minimum": 1.5,
            "type": "number"
          },
          "height": {
            "maximum": 2048,
            "minimum": 256,
            "type": "integer"
          },
          "image_prompt": {
            "format": "uri",
            "type": "string"
          },
          "image_prompt_strength": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "input_images": {
            "items": {
              "format": "uri",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "output_format": {
            "enum": [
              "jpg",
              "png",
              "webp"
            ],
            "type": "string"
          },
          "output_quality": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "prompt_upsampling": {
            "type": "boolean"
          },
          "raw": {
            "type": "boolean"
          },
          "resolution": {
            "enum": [
              "0.5MP",
              "1MP",
              "2MP",
              "4MP",
              "match_input_image"
            ],
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "steps": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "width": {
            "maximum": 2048,
            "minimum": 256,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "prompt": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "webhookUrl": {
        "format": "uri",
        "type": "string"
      },
      "webhookEvents": {
        "items": {
          "enum": [
            "progress",
            "completed",
            "failed"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    }
  },
  "wireMetadata": {
    "modelField": "model",
    "paramsField": "fluxParams",
    "wirePath": "fluxParams"
  }
}
